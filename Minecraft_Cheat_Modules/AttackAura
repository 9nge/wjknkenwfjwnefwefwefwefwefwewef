package pub.godweer.cc.rotations;

import net.minecraft.client.player.LocalPlayer;
import net.minecraft.util.Mth;
import net.minecraft.world.entity.LivingEntity;
import net.minecraft.world.phys.Vec3;
import pub.godweer.cc.AuraRotation;
import pub.godweer.cc.RotationHandler;

import java.util.concurrent.ThreadLocalRandom;

public final class SpookyTimeV3 implements AuraRotation {

    private static final int VEL_HIST = 6;
    private static final int VEL_DELAY = 4;

    private static final float[][] STYLES = {
            {0.55F, 0.80F, 25.0F, 42.0F, 0.35F, 0.015F, 0.30F, 0.50F},
            {0.35F, 0.55F, 15.0F, 30.0F, 0.50F, 0.030F, 0.15F, 0.90F},
            {0.70F, 0.95F, 30.0F, 48.0F, 0.25F, 0.010F, 0.45F, 0.35F},
            {0.30F, 0.45F, 14.0F, 26.0F, 0.60F, 0.050F, 0.10F, 1.10F},
            {0.45F, 0.65F, 20.0F, 36.0F, 0.40F, 0.025F, 0.20F, 0.70F},
    };

    private static final float[] STYLE_WEIGHTS = {0.20F, 0.20F, 0.20F, 0.15F, 0.25F};

    private static final float[][] WAVEFORMS = {
            {1.0F, -0.6F, 0.3F, -0.15F},
            {0.7F, 0.5F, -0.8F, -0.2F, 0.4F},
            {1.0F, -1.0F, 0.5F, 0.2F},
            {0.5F, 0.9F, -0.4F, -0.9F, 0.3F, 0.6F},
            {-0.8F, 1.0F, -0.3F, 0.4F},
    };

    private final float[] saccadePlan = new float[8];
    private int planLen = 0;
    private int planIdx = 0;

    private int styleIdx = 4;
    private int styleTtl = 0;

    private double mood;
    private float leadFactor;
    private float microResp;
    private float pitchDeadzone;

    private int burstTicks = 0;
    private int waveIdx = 0;
    private float[] activeWave = WAVEFORMS[0];

    private int correctionTtl = 0;

    private final Vec3[] velHist = new Vec3[VEL_HIST];
    private int velIdx = 0;
    private int velFilled = 0;

    private int lastTargetId = -1;
    private int prevLateralSign = 0;
    private int reactionHold = 0;
    private Vec3 leadSm = Vec3.ZERO;
    private Vec3 drift = Vec3.ZERO;
    private Vec3 driftGoal = Vec3.ZERO;
    private int goalTtl = 0;

    @Override
    public String getName() {
        return "SpookyV3";
    }

    @Override
    public void tick(LocalPlayer player, LivingEntity target, Vec3 targetEyePos, boolean attackLikely) {
        if (player == null || target == null || targetEyePos == null) return;

        ThreadLocalRandom rnd = ThreadLocalRandom.current();

        if (target.getId() != lastTargetId) {
            lastTargetId = target.getId();
            rollEngagement(rnd);
        }

        if (--styleTtl <= 0 || rnd.nextFloat() < 0.002F) {
            rollStyle(rnd);
        }

        mood += (rnd.nextDouble() - 0.5) * 0.02 + (0.78 - mood) * 0.01;
        mood = Mth.clamp(mood, 0.55, 1.0);

        float currentYaw = RotationHandler.isActive() ? RotationHandler.getServerYaw() : player.getYRot();
        float currentPitch = RotationHandler.isActive() ? RotationHandler.getServerPitch() : player.getXRot();

        Vec3 nowVel = new Vec3(target.getX() - target.xo, target.getY() - target.yo, target.getZ() - target.zo);
        velHist[velIdx] = nowVel;
        velIdx = (velIdx + 1) % VEL_HIST;
        if (velFilled < VEL_HIST) velFilled++;

        float[] style = STYLES[styleIdx];
        float pitchFollow = style[7];

        Vec3 delayedVel = velFilled > VEL_DELAY
                ? velHist[(velIdx - VEL_DELAY + VEL_HIST) % VEL_HIST]
                : nowVel;

        double yawRad = Math.toRadians(currentYaw);
        double lateral = nowVel.x * Math.cos(yawRad) + nowVel.z * Math.sin(yawRad);
        int lateralSign = lateral > 0.02 ? 1 : (lateral < -0.02 ? -1 : 0);
        boolean strafeReversed = prevLateralSign != 0 && lateralSign != 0 && lateralSign != prevLateralSign;
        prevLateralSign = lateralSign;

        if (--goalTtl <= 0) {
            goalTtl = rnd.nextInt(50, 110);
            driftGoal = new Vec3(
                    rnd.nextDouble(-0.22, 0.22),
                    rnd.nextDouble(-0.3, 0.08),
                    rnd.nextDouble(-0.22, 0.22)
            );
        }
        drift = drift.add(driftGoal.subtract(drift).scale(0.06));

        Vec3 aimPos = targetEyePos.add(drift);

        if (delayedVel.lengthSqr() > 1.0E-6) {
            double dist = player.getEyePosition().distanceTo(target.getBoundingBox().getCenter());
            double leadScale = Math.min(1.0, Math.max(0.0, dist / 3.0));
            Vec3 leadTarget = delayedVel.scale(leadScale * leadFactor);
            leadSm = leadSm.add(leadTarget.subtract(leadSm).scale(0.5));
            aimPos = aimPos.add(leadSm);
        } else {
            leadSm = leadSm.scale(0.5);
        }

        Vec3 delta = aimPos.subtract(player.getEyePosition());
        float rawYaw = (float) Math.toDegrees(Math.atan2(delta.z, delta.x)) - 90.0F;
        float rawPitch = (float) -Math.toDegrees(Math.atan2(delta.y * pitchFollow, Math.hypot(delta.x, delta.z)));

        float errYaw = Mth.wrapDegrees(rawYaw - currentYaw);
        float errPitch = Mth.clamp(rawPitch - currentPitch, -90.0F, 90.0F);
        float totalErr = (float) Math.hypot(errYaw, errPitch);

        if (totalErr < 0.05F) {
            return;
        }

        if (totalErr < 1.5F) {
            planLen = 0;
            planIdx = 0;
        }

        if (strafeReversed && !attackLikely && totalErr > 4.0F && totalErr < 30.0F
                && reactionHold == 0 && rnd.nextFloat() < 0.35F) {
            reactionHold = rnd.nextInt(1, 4);
        }

        if (reactionHold > 0) {
            reactionHold--;
            if (burstTicks > 0) {
                burstTicks--;
                applyBurstWave(currentYaw, currentPitch);
            }
            return;
        }

        float yawCapBase = style[2] + (style[3] - style[2]) * rnd.nextFloat();
        float pitchCapBase = yawCapBase * (float) rnd.nextDouble(0.45, 0.65);
        float yawCap = yawCapBase * (float) mood + urgency(attackLikely) * 10.0F;
        float pitchCap = pitchCapBase * (float) mood + urgency(attackLikely) * 6.0F;

        float stepYaw;
        float stepPitch;

        if (attackLikely) {
            stepYaw = Mth.clamp(errYaw * 0.85F, -yawCap * 1.3F, yawCap * 1.3F);
            stepPitch = Mth.clamp(errPitch * 0.85F, -pitchCap * 1.3F, pitchCap * 1.3F);
        } else if (totalErr > 6.0F) {
            if (planIdx >= planLen) {
                buildSaccadePlan(rnd, style, totalErr);
            }
            float frac = saccadePlan[planIdx++];
            stepYaw = Mth.clamp(errYaw * frac, -yawCap, yawCap);
            stepPitch = Mth.clamp(errPitch * frac * (0.6F + pitchFollow * 0.4F), -pitchCap, pitchCap);
        } else {
            if (correctionTtl > 0) {
                correctionTtl--;
                stepYaw = Mth.clamp(errYaw * microResp, -yawCap, yawCap);
                stepPitch = Mth.clamp(errPitch * microResp * 0.7F, -pitchCap, pitchCap);
            } else {
                if (rnd.nextFloat() < 0.12F + style[5]) {
                    correctionTtl = rnd.nextInt(1, 4);
                    microResp = (float) (rnd.nextDouble(0.25, 0.6) * mood);
                    pitchDeadzone = (float) rnd.nextDouble(0.2, 0.5);
                }
                stepYaw = 0.0F;
                stepPitch = 0.0F;
            }
        }

        if (!attackLikely && totalErr > 5.0F && totalErr < 45.0F
                && rnd.nextFloat() < style[6]) {
            float over = (float) rnd.nextDouble(1.12, 1.45);
            stepYaw = Mth.clamp(stepYaw * over, -yawCap * 1.2F, yawCap * 1.2F);
            stepPitch = Mth.clamp(stepPitch * over, -pitchCap * 1.2F, pitchCap * 1.2F);
        }

        if (!attackLikely && Math.abs(errPitch) < pitchDeadzone) {
            stepPitch = 0.0F;
        }

        if (Math.abs(stepYaw) > 0.1F && Math.abs(stepPitch) > 0.1F) {
            float ratio = Math.abs(stepYaw) / Math.abs(stepPitch);
            if (ratio > 0.85F && ratio < 1.18F) {
                stepYaw *= 1.25F;
            }
        }

        if (!attackLikely && burstTicks > 0) {
            burstTicks--;
            stepYaw += waveValue(style, totalErr);
            stepPitch += waveValue(style, totalErr) * 0.5F;
        } else if (!attackLikely && burstTicks == 0 && rnd.nextFloat() < style[5]) {
            burstTicks = rnd.nextInt(1, 5);
            activeWave = WAVEFORMS[rnd.nextInt(WAVEFORMS.length)];
            waveIdx = 0;
        }

        if (Math.abs(stepYaw) < 0.05F && Math.abs(stepPitch) < 0.05F) {
            return;
        }

        RotationHandler.setRotation(
                currentYaw + stepYaw,
                Mth.clamp(currentPitch + stepPitch, -89.5F, 89.5F)
        );
    }

    private void applyBurstWave(float currentYaw, float currentPitch) {
        float[] style = STYLES[styleIdx];
        float n = waveValue(style, 10.0F);
        RotationHandler.setRotation(currentYaw + n, Mth.clamp(currentPitch + n * 0.5F, -89.5F, 89.5F));
    }

    private float waveValue(float[] style, float totalErr) {
        float v = activeWave[waveIdx % activeWave.length];
        waveIdx++;
        return v * (0.15F + Math.min(totalErr * 0.02F, 0.35F)) * style[4];
    }

    private float urgency(boolean attackLikely) {
        return attackLikely ? 1.0F : 0.0F;
    }

    private void buildSaccadePlan(ThreadLocalRandom rnd, float[] style, float totalErr) {
        planLen = rnd.nextInt(3, 7);
        planIdx = 0;
        float f = (float) rnd.nextDouble(style[0], style[1] + 0.15);
        boolean plantedOvershoot = rnd.nextFloat() < style[6];
        int overAt = plantedOvershoot ? rnd.nextInt(1, planLen - 1) : -1;

        for (int i = 0; i < planLen; i++) {
            if (i == overAt) {
                saccadePlan[i] = -(float) rnd.nextDouble(0.10, 0.28);
                f *= (float) rnd.nextDouble(0.6, 0.9);
            } else {
                saccadePlan[i] = f;
                f *= (float) rnd.nextDouble(0.45, 0.8);
            }
        }
    }

    private void rollEngagement(ThreadLocalRandom rnd) {
        rollStyle(rnd);
        mood = rnd.nextDouble(0.65, 0.9);
        leadFactor = (float) rnd.nextDouble(0.55, 0.9);
        prevLateralSign = 0;
        reactionHold = 0;
        burstTicks = 0;
        planLen = 0;
        planIdx = 0;
        correctionTtl = 0;
        velFilled = 0;
        velIdx = 0;
        leadSm = Vec3.ZERO;
        drift = Vec3.ZERO;
        driftGoal = Vec3.ZERO;
        goalTtl = 0;
    }

    private void rollStyle(ThreadLocalRandom rnd) {
        float roll = rnd.nextFloat();
        float acc = 0.0F;
        for (int i = 0; i < STYLES.length; i++) {
            acc += STYLE_WEIGHTS[i];
            if (roll <= acc) {
                styleIdx = i;
                break;
            }
        }
        styleTtl = rnd.nextInt(80, 160);
        planLen = 0;
        planIdx = 0;
    }

    @Override
    public void reset() {
        ThreadLocalRandom rnd = ThreadLocalRandom.current();
        lastTargetId = -1;
        rollEngagement(rnd);
    }
}
